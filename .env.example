# Copy to .env and fill in real values. NEVER commit .env.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
PORT=8030
SITE_URL=http://127.0.0.1:8030
SITE_NAME=Ascendancy Academy

# Local Postgres (change host/port to match your machine). Rocky uses localhost:5432.
DATABASE_URL=postgresql+psycopg://aa:change-me@localhost:5432/aa

# Seed accounts (forced password change on first login)
TEACHER1_EMAIL=joe@example.com
TEACHER1_PASSWORD=change-me-on-first-login
TEACHER1_FIRST_NAME=Joe
TEACHER1_LAST_NAME=DiFede

TEACHER2_EMAIL=teacher@example.com
TEACHER2_PASSWORD=change-me-on-first-login
TEACHER2_FIRST_NAME=Mrs.
TEACHER2_LAST_NAME=DiFede

STUDENT1_EMAIL=gregory@example.com
STUDENT1_PASSWORD=change-me-on-first-login
STUDENT1_FIRST_NAME=Gregory
STUDENT1_LAST_NAME=DiFede

# Session cookie Secure flag: true | false | auto (auto reads X-Forwarded-Proto)
COOKIE_SECURE=auto
COOKIE_DOMAIN=
SESSION_COOKIE_NAME=aa_session
SESSION_TTL_HOURS=720
MAX_FAILED_ATTEMPTS=8
LOCKOUT_MINUTES=15

# Cloudflare Turnstile — copy the HV3 widget keys into .env only (never git).
# Add aa.difedes.com as a hostname on that widget before enabling on Rocky.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_FAIL_OPEN=false

STORAGE_DIR=storage
TESTING=false
